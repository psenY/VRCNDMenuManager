/* Menu Generator Wizard Stylesheet */

.wizard-root {
    flex-grow: 1;
    background-color: #14151b;
    color: #e2e8f0;
    font-size: 14px;
}

/* Header */
.wizard-header {
    padding: 16px 20px;
    background-color: #1a1b24;
    border-bottom-width: 1px;
    border-bottom-color: #272a38;
}

.wizard-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: #a78bfa;
}

.wizard-sub {
    font-size: 12px;
    color: #64748b;
    margin-top: 3px;
}

/* Tabs */
.tab-row {
    flex-direction: row;
    padding: 10px 16px;
    background-color: #161720;
    border-bottom-width: 1px;
    border-bottom-color: #272a38;
}

.tab-btn {
    flex-grow: 1;
    height: 36px;
    background-color: #222533;
    color: #94a3b8;
    border-radius: 6px;
    border-width: 1px;
    border-color: #32364a;
    margin: 2px 4px;
    font-size: 13.5px;
    -unity-font-style: bold;
    cursor: link;
}

.tab-btn:hover {
    background-color: #2e3346;
    color: #ffffff;
}

.tab-active {
    background-color: #4f46e5;
    color: #ffffff;
    border-color: #6366f1;
}

/* Body */
.wizard-body {
    flex-grow: 1;
    padding: 16px;
}

.card-section {
    background-color: #1a1b24;
    border-radius: 8px;
    border-width: 1px;
    border-color: #272a38;
    padding: 14px;
    margin-bottom: 12px;
}

.section-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: #38bdf8;
    margin-bottom: 8px;
}

.form-field {
    margin-bottom: 8px;
    font-size: 14px;
}

.preset-tag-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 2px;
}

.preset-label {
    font-size: 12px;
    color: #64748b;
    margin-right: 6px;
}

.preset-btn {
    height: 24px;
    padding: 2px 10px;
    background-color: #242738;
    color: #a5b4fc;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3b3f5c;
    font-size: 12px;
    margin-right: 6px;
    cursor: link;
}

.preset-btn:hover {
    background-color: #4338ca;
    color: #ffffff;
    border-color: #6366f1;
}

.form-toggle {
    margin-bottom: 6px;
    font-size: 13.5px;
    color: #cbd5e1;
}

/* Drop Area */
.drop-zone {
    height: 60px;
    border-width: 2px;
    border-color: #4338ca;
    border-radius: 8px;
    background-color: #171827;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
}

.drop-zone:hover {
    background-color: #1e1f36;
    border-color: #6366f1;
}

.drop-hint-text {
    color: #818cf8;
    font-size: 13.5px;
    -unity-font-style: bold;
}

/* Dropped Items List */
.item-list-container {
    max-height: 240px;
    background-color: #12131a;
    border-radius: 6px;
    border-width: 1px;
    border-color: #272a3a;
    padding: 6px;
}

.item-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    min-height: 40px;
    height: 40px;
    background-color: #1d1e2a;
    border-radius: 6px;
    margin-bottom: 5px;
    border-width: 1px;
    border-color: #2c3044;
}

.item-row:hover {
    background-color: #242738;
    border-color: #4f46e5;
}

.item-index-badge {
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 4px;
    background-color: #3730a3;
    color: #c7d2fe;
    margin-right: 6px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.item-index-default {
    background-color: #065f46;
    color: #a7f3d0;
}

.item-order-btn {
    width: 24px;
    height: 24px;
    background-color: #2a2d3e;
    color: #cbd5e1;
    border-radius: 4px;
    border-width: 0;
    -unity-text-align: middle-center;
    font-size: 11px;
    margin-right: 3px;
    cursor: link;
    padding: 0;
}

.item-order-btn:hover {
    background-color: #4338ca;
    color: #ffffff;
}

.item-name-input {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 8px;
    font-size: 13.5px;
    height: 28px;
}

.item-name-input > .unity-base-text-field__input {
    background-color: #12131b;
    border-color: #353a50;
    border-radius: 4px;
    color: #f8fafc;
    padding: 2px 8px;
    font-size: 13.5px;
}

.item-source-label {
    font-size: 11.5px;
    color: #64748b;
    margin-right: 8px;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 0;
}

.item-del-btn {
    width: 24px;
    height: 24px;
    background-color: #7f1d1d;
    color: #fecaca;
    border-radius: 4px;
    border-width: 0;
    -unity-text-align: middle-center;
    font-size: 12px;
    cursor: link;
    flex-shrink: 0;
}

.item-del-btn:hover {
    background-color: #b91c1c;
    color: #ffffff;
}

/* Footer */
.wizard-footer {
    padding: 14px 20px;
    background-color: #1a1b24;
    border-top-width: 1px;
    border-top-color: #272a38;
}

.btn-generate {
    height: 44px;
    background-color: #16a34a;
    color: #ffffff;
    border-radius: 8px;
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    cursor: link;
    -unity-text-align: middle-center;
}

.btn-generate:hover {
    background-color: #22c55e;
}
